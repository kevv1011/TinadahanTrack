# Keep this file safe to commit. Put real values only in server/.env.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
CORS_ORIGINS=http://localhost:5173,https://kevv1011.github.io,http://localhost,https://localhost

# Generate this using: npm run auth:hash
OWNER_PASSWORD_HASH=scrypt$replace-with-generated-salt$replace-with-generated-hash
# Use a long, random value (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret
# Optional. Defaults to 12h.
AUTH_TOKEN_TTL=12h
