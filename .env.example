# ── Client / build-time variables ──────────────────────────────
# These are compiled into the JavaScript bundle and are PUBLIC.
# Never put passwords, keys, or connection strings here.

# Set to false to call the real Express API instead of localStorage.
# Any other value (or missing) defaults to demo mode.
VITE_USE_MOCK_API=true

# Your deployed API's public URL, no trailing slash.
# Example: https://tindahantrack-api.onrender.com
VITE_API_BASE_URL=http://localhost:3001
